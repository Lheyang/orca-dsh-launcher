<?xml version="1.0" encoding="utf-8"?>
<!--
  本仓库的 NuGet 源设置。
  普通编译（框架依赖）不需要联网；只有 publish.cmd 打自包含单文件安装器时，
  需要从官方源下载 .NET 运行时包（Microsoft.NETCore.App.Runtime.win-x64 等）。
  这里显式声明官方源，避免受机器全局 NuGet 配置（可能被清空）影响。
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
