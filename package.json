{
  "name": "orca-dsh-launcher",
  "description": "Orca DSH Launcher：DSH 全能插件 —— 启动更新检查 + 服务器启停 + Orca 托盘 + 桌面控制台（独立管理窗口）。",
  "version": "1.6.0",
  "type": "module",
  "main": "plugin.js",
  "exports": {
    ".": {
      "default": "./plugin.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "plugin": true,
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  },
  "license": "MIT",
  "keywords": [
    "deepseek",
    "harness",
    "dsh",
    "orca",
    "launcher",
    "tray",
    "update",
    "checker",
    "plugin"
  ]
}
